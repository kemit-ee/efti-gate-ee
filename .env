# LOGGER_CLASS=klite.slf4j.StackTraceOptimizingLogger - plain text, if preferred over ECS JSON
LOGGER_CLASS=klite.slf4j.EcsJsonLogger

OWN_GATE_ID=EU-EE
RUUTER_URL=http://localhost:8086
RESQL_URL=http://localhost:8090
EDELIVERY_URL=http://localhost:8081
KEYSTORE_DIR=code/certs
# Must match constants.ini's INTERNAL_SERVICE_TOKEN — edelivery sends this on every
# efti/api/v1/* call now that DSL/Ruuter/efti/POST/api/v1/.guard.yml requires it.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me
# CronManager: OPS_AUTHORIZATION is the whole header and must match constants.ini's
# ARCHIVE_OPS_TOKEN; CRONMANAGER_ADMIN_TOKEN gates /execute|/stop|/reload (unset → no start).
OPS_AUTHORIZATION=Bearer dev-archive-ops-token-change-me
CRONMANAGER_ADMIN_TOKEN=dev-cronmanager-admin-token-change-me
# XTR (outbound X-Road): must match constants.ini's XTR_INTER_SERVICE_TOKEN. XTR_KEYSTORE_PASSWORD is the
# password of xtr/ssl/xtr-client.p12 (set it locally, do not commit a real one).
XTR_INTER_SERVICE_TOKEN=dev-xtr-inter-service-token-change-me
XTR_KEYSTORE_PASSWORD=changeit
