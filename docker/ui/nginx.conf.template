server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /admin/ {
        proxy_pass http://ruuter:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /efti/internal/* (check-user-authority, check-admin-authority) are Ruuter-loopback
    # only — the .guard files call them over 127.0.0.1. They must never be reachable from
    # outside; 404 them here so the /efti/ passthrough below cannot expose them.
    location ^~ /efti/internal/ {
        return 404;
    }

    location /efti/api/v1/authority/ {
        proxy_pass http://ruuter:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public developer mock of the X-Road authority surface. Isolated container with no DB /
    # no core (docs/specs/x_road_developer_mock.md) — safe to expose. NOT the real /xroad/**,
    # which must never be publicly routable (ADR-006).
    location /developer/ {
        proxy_pass http://ruuter-xroad-mock:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth/ {
        proxy_pass http://ruuter:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /platforms/v1/ {
        proxy_pass http://ruuter:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /tim/ {
        proxy_pass http://tim:8085/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /tara/ {
        proxy_pass https://tara-mock:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }

    # Browser-facing runtime settings, rendered at container start from the environment
    # (nginx envsubst on /etc/nginx/templates), so deployment values stay out of the image.
    location = /runtime-config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"taraRedirectUri":"${TARA_REDIRECT_URI}"}';
    }

    # TARA sends the browser back here. It is an SPA route, so it must win over /auth/ (Ruuter).
    location ~ ^/auth/callback/?$ {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
