# Public at this level — Ruuter 0.9.x chains every guard in the path hierarchy, so a
# non-public guard here would also gate POST/api/v1/auth/ (login/logout/callback).
# Admin-only POST endpoints (gates, platforms, authorities, users, users/revoke-token,
# platforms/api-key) enforce ADMIN with a check-admin-authority call at the start of
# their own DSL. Machine-to-machine POSTs (peer-gate eDelivery, Authority API,
# Platform API) live on the m2m Ruuter (port 8087), each behind its own guard.
guard_success:
  return: "success"
  status: 200
  next: end
