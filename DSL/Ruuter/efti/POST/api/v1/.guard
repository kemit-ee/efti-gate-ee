# Admin only. Every POST under /api/v1 is an admin UI write (gates, platforms,
# authorities, users, users/revoke-token). Login/logout/callback are under
# POST/api/v1/auth/ with their own public guard.
# Machine-to-machine POSTs (peer-gate eDelivery, authority API, platform API) live
# on the m2m Ruuter (port 8087), each behind its own guard — they are not routed here.
validate_auth:
  call: http.post
  args:
    url: "[#RUUTER_URL]/efti/internal/check-admin-authority"
    headers:
      Content-Type: application/json
      authorization: ${incoming.headers.authorization}
    body: {}
  result: auth_result
  next: check_result

check_result:
  switch:
    - condition: ${auth_result.response.status == 200}
      next: guard_success
  next: guard_fail

guard_success:
  return: "success"
  status: 200
  next: end

guard_fail:
  return: ${auth_result.response.body}
  status: ${auth_result.response.status}
  next: end
