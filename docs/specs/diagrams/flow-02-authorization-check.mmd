flowchart TD
    Start([Incoming HTTP Request]) --> ProxyType{Cred type?}

    ProxyType -->|"X-Client-Cert-Subject<br/>(mTLS, Platform API)"| LookupCert["SELECT DISTINCT ON (id) id<br/>FROM platforms<br/>WHERE cert_subject = $1<br/>AND cert_serial = $2<br/>AND is_active = TRUE<br/>ORDER BY id, created_at DESC"]
    ProxyType -->|"Authorization: Bearer JWT<br/>(Authority / Admin)"| ValidateJwt[Validate JWT signature<br/>against cached JWKS;<br/>check iss, aud, exp]
    ProxyType -->|"Authorization: Bearer ARCHIVE_OPS_TOKEN<br/>(CronManager admin/*)"| OpsCompare["Literal compare<br/>token == ARCHIVE_OPS_TOKEN env var"]
    ProxyType -->|"None"| Anon[Anonymous request]

    LookupCert --> CertCount{Active platforms<br/>matching cert?}
    CertCount -->|0| Ret403NP[403 FORBIDDEN_NO_PLATFORM]
    CertCount -->|>1| Ret403MP[403 FORBIDDEN_MULTI_PLATFORM<br/>config error]
    CertCount -->|1| PlatformAccess[Set platformId in context<br/>Proceed to platform route handler]

    ValidateJwt --> JwtValid{Signature/iss/aud/exp ok?}
    JwtValid -->|No| Ret401[401 TOKEN_INVALID]
    JwtValid -->|Yes| Denylist["SELECT 1 FROM sessions<br/>WHERE jti = $1 AND expires_at > NOW()"]

    Denylist --> Revoked{In denylist?}
    Revoked -->|Yes| Ret401Rev[401 TOKEN_INVALID<br/>token revoked]
    Revoked -->|No| LookupUser["SELECT DISTINCT ON (tara_sub) id, roles, subsets,<br/>is_admin, is_active FROM users<br/>WHERE tara_sub = jwt.sub<br/>ORDER BY tara_sub, created_at DESC"]

    LookupUser --> UserFound{User row found<br/>AND is_active=TRUE?}
    UserFound -->|No| Ret401NoUser[401 TOKEN_INVALID<br/>no provisioned user / inactive]
    UserFound -->|Yes| ExtractClaims[Read users.roles, users.subsets,<br/>users.scope as the authorisation source]

    ExtractClaims --> RouteType{Required role on route?}
    RouteType -->|AUTHORITY| CheckAuth{roles ∋ AUTHORITY?}
    RouteType -->|ADMIN| CheckAdmin{roles ∋ ADMIN?}
    RouteType -->|OPS| Ret403Wrong[403 FORBIDDEN<br/>OPS routes use opsToken, not JWT]

    CheckAuth -->|No| Ret403[403 FORBIDDEN]
    CheckAuth -->|Yes| AuthorityAccess[Set authorityId from scope<br/>subsetCheck against requested subsets<br/>Proceed to authority route]

    CheckAdmin -->|No| Ret403
    CheckAdmin -->|Yes| AdminWrite{Mutating endpoint<br/>with entityId param?}
    AdminWrite -->|Yes| CheckScope{entityId ∈ scope claim?}
    AdminWrite -->|No| AdminAccess[Proceed to admin route]
    CheckScope -->|No| Ret403WA[403 FORBIDDEN_WRITE_ACCESS]
    CheckScope -->|Yes| AdminAccess

    OpsCompare --> OpsMatch{Tokens equal?}
    OpsMatch -->|No| Ret403Ops[403 FORBIDDEN]
    OpsMatch -->|Yes| OpsAccess[Proceed to /api/v1/admin/ route]

    Anon --> AnonRoute{Route allows<br/>anonymous?}
    AnonRoute -->|Yes /health| AnonProceed[Proceed]
    AnonRoute -->|No| Ret401Unauth[401 Unauthorized]

    PlatformAccess --> Exec([Execute route handler])
    AuthorityAccess --> Exec
    AdminAccess --> Exec
    OpsAccess --> Exec
    AnonProceed --> Exec

    style Ret401 fill:#f99,stroke:#900
    style Ret401Rev fill:#f99,stroke:#900
    style Ret401NoUser fill:#f99,stroke:#900
    style Ret401Unauth fill:#f99,stroke:#900
    style Ret403 fill:#f99,stroke:#900
    style Ret403Wrong fill:#f99,stroke:#900
    style Ret403WA fill:#f99,stroke:#900
    style Ret403Ops fill:#f99,stroke:#900
    style Ret403NP fill:#f99,stroke:#900
    style Ret403MP fill:#f99,stroke:#900
    style Exec fill:#9f9,stroke:#060
