graph TB
    subgraph EU["EU eFTI Gate Network (eDelivery AS4)"]
        subgraph EE["Estonia (<gateId>)"]
            GateEE[eFTI Gate\n<gateId>\n<as4Url>]
        end

        subgraph FI["Finland (<peerGateA>)"]
            GateFI[eFTI Gate\n<peerGateA>\n<as4Url>]
        end

        subgraph DE["Germany (<peerGateB>)"]
            GateDE[eFTI Gate\n<peerGateB>\n<as4Url>]
        end

        subgraph SE["Sweden (<peerGateC>)"]
            GateSE[eFTI Gate\n<peerGateC>\n<as4Url>]
        end

        subgraph LT["Lithuania (<peerGateD>)"]
            GateLT[eFTI Gate\n<peerGateD>\n<as4Url>]
        end

        subgraph LV["Latvia (<peerGateE>)"]
            GateLV[eFTI Gate\n<peerGateE>\n<as4Url>]
        end

        subgraph PL["Poland (<peerGateF>)"]
            GatePL[eFTI Gate\n<peerGateF>\n<as4Url>]
        end
    end

    GateEE <-.->|eDelivery AS4\nIdentifierQuery / UILQuery| GateFI
    GateEE <-.->|eDelivery AS4| GateDE
    GateEE <-.->|eDelivery AS4| GateSE
    GateEE <-.->|eDelivery AS4| GateLT
    GateEE <-.->|eDelivery AS4| GateLV
    GateEE <-.->|eDelivery AS4| GatePL

    GateFI <-.->|eDelivery AS4| GateDE
    GateFI <-.->|eDelivery AS4| GateSE
    GateFI <-.->|eDelivery AS4| GateLT

    subgraph EEPlatforms["Estonian Platforms"]
        PltEE1[<platformId>\n<orgName>]
        PltEE2[<platformB>\n<orgName>]
    end

    subgraph EEAuthorities["Estonian Authorities"]
        AutPolitsei[<authorityA>\n<authorityName>]
        AutMaksu[<authorityB>\n<authorityName>]
    end

    subgraph FIPlatforms["Finnish Platforms"]
        PltFI1[<platformId>\n<orgName>]
    end

    GateEE <-->|HTTPS REST API| PltEE1
    GateEE <-->|HTTPS REST API| PltEE2
    GateEE <-->|HTTPS REST API| AutPolitsei
    GateEE <-->|HTTPS REST API| AutMaksu
    GateFI <-->|HTTPS REST API| PltFI1

    style EU fill:#fff9e6,stroke:#ffc107
    style EE fill:#e3f2fd,stroke:#2196F3
    style FI fill:#e8f5e9,stroke:#4CAF50
    style DE fill:#fce4ec,stroke:#E91E63
    style SE fill:#f3e5f5,stroke:#9C27B0
    style LT fill:#fff3e0,stroke:#FF9800
    style LV fill:#e0f7fa,stroke:#00BCD4
    style PL fill:#fafafa,stroke:#607D8B
