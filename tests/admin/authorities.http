### Auth: dev login as Super Admin
POST {{RUUTER_URL}}/auth/dev-login
Content-Type: application/json

{
  "personalCode": "60001019906",
  "firstName": "Super",
  "lastName": "Admin"
}

> {%
  client.test("Admin JWT issued", () => {
    client.assert(response.status === 200)
    client.assert(response.body.token.startsWith("eyJ"))
    client.global.set("adminToken", response.body.token)
  })
%}

### Cleanup: delete existing test authority if present
DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-mta
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### Create authority
POST {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "auth-mta",
  "name": "Estonian Tax and Customs Board",
  "registryCode": "70000001",
  "subsets": ["EU01", "EU02", "EU03"],
  "status": "ACTIVE"
}

> {%
  client.test("Authority created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.id === "auth-mta")
    client.assert(response.body.name === "Estonian Tax and Customs Board")
    client.assert(response.body.registryCode === "70000001")
    client.assert(response.body.status === "ACTIVE")
  })
%}

### List authorities
GET {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Authorities listed", () => {
    client.assert(response.status === 200)
    client.assert(response.body.length >= 1)
  })
%}

### Get single authority
GET {{RUUTER_URL}}/admin/v1/authorities/auth-mta
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Single authority found", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "auth-mta")
  })
%}

### Update authority
PUT {{RUUTER_URL}}/admin/v1/authorities/auth-mta
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Estonian Tax and Customs Board",
  "registryCode": "70000001",
  "subsets": ["EU01", "EU02", "EU03", "EU04"],
  "status": "ACTIVE"
}

> {%
  client.test("Authority updated", () => {
    client.assert(response.status === 200)
    client.assert(response.body.subsets.length === 4)
  })
%}

### Delete authority
DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-mta
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Authority deleted", () => {
    client.assert(response.status === 204)
  })
%}

### Verify authority deleted
GET {{RUUTER_URL}}/admin/v1/authorities/auth-mta
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Authority deleted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.status === "DELETED")
  })
%}
