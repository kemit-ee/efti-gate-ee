import ./auth.http
run #auth

### List authorities — registry/authorities/*.json is the source of truth (ADR-014)
GET {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Authorities listed from the registry fixtures", () => {
    client.assert(response.status === 200)
    client.assert(Array.isArray(response.body))
    const ids = response.body.map(a => a.id)
    client.assert(ids.includes("auth-xroad-test"))
    client.assert(ids.includes("auth-xroad-subsets"))
    client.assert(ids.includes("auth-xroad-empty"))
    client.assert(ids.includes("auth-summary-eu03"))
    client.assert(ids.includes("auth-summary-none"))
  })
%}

### Get a single authority (registry/authorities/auth-xroad-test.json)
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-test read back from the registry", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "auth-xroad-test")
    client.assert(response.body.name === "X-Road Test Authority")
    client.assert(response.body.registryCode === "70000099")
    client.assert(response.body.subsets.length === 1)
    client.assert(response.body.subsets.includes("EU01"))
  })
%}

### An authority entitled to several subsets keeps them all
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-subsets
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-subsets keeps its declared subsets", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000097")
    client.assert(response.body.subsets.length === 2)
    client.assert(response.body.subsets.includes("EU01"))
    client.assert(response.body.subsets.includes("EU05"))
  })
%}

### An authority entitled to nothing declares an empty subset list
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-empty
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-empty has no subsets", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000096")
    client.assert(response.body.subsets.length === 0)
  })
%}

### NEGATIVE: GET without auth → 401
GET {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json

> {%
  client.test("GET authorities without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}

### NEGATIVE: the authority write API is gone (ADR-014) — registry is read-only
# The path IS still routed, but only for GET, so a write method is "method not allowed"
# rather than "not found", and no guard runs to produce 401/403.
POST {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json

{"id": "NOAUTH", "name": "No Auth", "registryCode": "00000000", "subsets": ["EU01"]}

> {%
  client.test("POST /admin/v1/authorities rejected — registry is read-only (405)", () => {
    client.assert(response.status === 405)
  })
%}
