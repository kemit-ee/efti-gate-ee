import ./auth.http
run #auth

### Cleanup: delete existing test gate if present
DELETE {{RUUTER_URL}}/admin/v1/gates/TEST
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### Create gate
POST {{RUUTER_URL}}/admin/v1/gates
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "TEST",
  "countryCode": "EE",
  "eDeliveryUrl": "https://gate.example.com/services/msh",
  "eDeliveryCert": "-----BEGIN CERTIFICATE-----\ntest-cert\n-----END CERTIFICATE-----",
  "tlsCert": "-----BEGIN CERTIFICATE-----\ntest-tls-cert\n-----END CERTIFICATE-----",
  "status": "ONLINE"
}

> {%
  client.test("Gate created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.id === "TEST")
    client.assert(response.body.countryCode === "EE")
    client.assert(response.body.status === "ONLINE")
  })
%}

### List gates
GET {{RUUTER_URL}}/admin/v1/gates
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Gates listed", () => {
    client.assert(response.status === 200)
    client.assert(response.body.length >= 1)
  })
%}

### Get single gate
GET {{RUUTER_URL}}/admin/v1/gates/TEST
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Single gate found", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "TEST")
  })
%}

### Update gate
PUT {{RUUTER_URL}}/admin/v1/gates/TEST
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "countryCode": "EE",
  "eDeliveryUrl": "https://gate.example.com/services/msh/v2",
  "eDeliveryCert": "-----BEGIN CERTIFICATE-----\ntest-cert\n-----END CERTIFICATE-----",
  "tlsCert": "-----BEGIN CERTIFICATE-----\ntest-tls-cert\n-----END CERTIFICATE-----",
  "status": "ONLINE"
}

> {%
  client.test("Gate updated", () => {
    client.assert(response.status === 200)
    client.assert(response.body.eDeliveryUrl === "https://gate.example.com/services/msh/v2")
  })
%}

### Delete gate
DELETE {{RUUTER_URL}}/admin/v1/gates/TEST
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Gate deleted", () => {
    client.assert(response.status === 204)
  })
%}

### Verify gate deleted
GET {{RUUTER_URL}}/admin/v1/gates/TEST
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Gate deleted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.status === "DELETED")
  })
%}

