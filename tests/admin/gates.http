import ./auth.http
run #auth

### List gates — registry/gates/*.json is the source of truth (ADR-011)
GET {{RUUTER_URL}}/admin/v1/gates
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Gates listed from the registry fixtures", () => {
    client.assert(response.status === 200)
    client.assert(Array.isArray(response.body))
    const ids = response.body.map(g => g.id)
    client.assert(ids.includes("EU-EE"))
    client.assert(ids.includes("EU-MOCK"))
  })
%}

### Get the own gate (registry/gates/EU-EE.json)
GET {{RUUTER_URL}}/admin/v1/gates/EU-EE
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("EU-EE gate read back from the registry", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "EU-EE")
    client.assert(response.body.countryCode === "EE")
    client.assert(response.body.status === "ONLINE")
    client.assert(response.body.eDeliveryUrl === "http://edelivery:8081/services/msh")
  })
%}

### Get own gate by OWN_GATE_ID (gates/own)
GET {{RUUTER_URL}}/admin/v1/gates/own
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Own gate resolves to the EU-EE fixture", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "EU-EE")
    client.assert(response.body.status === "ONLINE")
  })
%}

### Get the loopback peer gate (registry/gates/EU-MOCK.json)
GET {{RUUTER_URL}}/admin/v1/gates/EU-MOCK
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("EU-MOCK gate read back from the registry", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "EU-MOCK")
    client.assert(response.body.countryCode === "EE")
    client.assert(response.body.status === "ONLINE")
    client.assert(response.body.eDeliveryUrl === "http://edelivery:8081/services/msh")
  })
%}

### NEGATIVE: GET without auth → 401
GET {{RUUTER_URL}}/admin/v1/gates
Content-Type: application/json

> {%
  client.test("GET gates without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}

### NEGATIVE: the gate write API is gone (ADR-011) — registry is read-only
# The path IS still routed, but only for GET (list + get-by-id), so a write method is
# rejected as "method not allowed" rather than "not found". 401/403 would need a guard to
# run, and Ruuter does not run one for a method that does not match a route.
POST {{RUUTER_URL}}/admin/v1/gates
Content-Type: application/json

{
  "id": "TEST",
  "countryCode": "EE",
  "eDeliveryUrl": "https://gate.example.com/services/msh",
  "status": "ONLINE"
}

> {%
  client.test("POST /admin/v1/gates rejected — registry is read-only (405)", () => {
    client.assert(response.status === 405)
  })
%}

### NEGATIVE: the ping job is gone — POST /admin/v1/gates/ping/{id} → 405
POST {{RUUTER_URL}}/admin/v1/gates/ping/EU-EE
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("POST /admin/v1/gates/ping/EU-EE rejected — read-only (405)", () => {
    client.assert(response.status === 405)
  })
%}
