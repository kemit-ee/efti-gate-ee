import ./auth.http
run #auth

### Cleanup: delete existing test platform if present
DELETE {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### Create platform
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "demo",
  "baseUrl": "https://demo-platform.example.com/api",
  "headers": {"X-Api-Key": "test-key-123"},
  "eDeliveryCert": "-----BEGIN CERTIFICATE-----\ntest-cert\n-----END CERTIFICATE-----",
  "tlsCert": "-----BEGIN CERTIFICATE-----\ntest-tls-cert\n-----END CERTIFICATE-----",
  "certSubject": "CN=demo-platform.example.com",
  "certSerial": "ABCDEF1234567890",
  "status": "ONLINE"
}

> {%
  client.test("Platform created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.id === "demo")
    client.assert(response.body.baseUrl === "https://demo-platform.example.com/api")
    client.assert(response.body.status === "ONLINE")
  })
%}

### List platforms
GET {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platforms listed", () => {
    client.assert(response.status === 200)
    client.assert(response.body.length >= 1)
  })
%}

### Get single platform
GET {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Single platform found", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "demo")
  })
%}

### Update platform
PUT {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "baseUrl": "https://demo-platform.example.com/api/v2",
  "headers": {"X-Api-Key": "updated-key-456"},
  "eDeliveryCert": "-----BEGIN CERTIFICATE-----\ntest-cert\n-----END CERTIFICATE-----",
  "tlsCert": "-----BEGIN CERTIFICATE-----\ntest-tls-cert\n-----END CERTIFICATE-----",
  "certSubject": "CN=demo-platform.example.com",
  "certSerial": "ABCDEF1234567890",
  "status": "ONLINE"
}

> {%
  client.test("Platform updated", () => {
    client.assert(response.status === 200)
    client.assert(response.body.baseUrl === "https://demo-platform.example.com/api/v2")
  })
%}

### Delete platform
DELETE {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platform deleted", () => {
    client.assert(response.status === 204)
  })
%}

### Verify platform deleted
GET {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platform deleted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.status === "DELETED")
  })
%}

### Ping platform (REST — no eDelivery cert)
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "ping-test",
  "baseUrl": "https://httpbin.org/status/200",
  "status": "ONLINE"
}

> {%
  client.test("Platform created for ping", () => {
    client.assert(response.status === 201)
  })
%}

### Check ping result
POST {{RUUTER_URL}}/admin/v1/platforms/ping/ping-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platform pinged (REST)", () => {
    client.assert(response.body.status === "ONLINE")
  })
%}

DELETE {{RUUTER_URL}}/admin/v1/platforms/ping-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### NEGATIVE: GET without auth → 401
GET {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json

> {%
  client.test("GET platforms without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}

### NEGATIVE: POST without auth → 401
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json

{"id": "NOAUTH", "baseUrl": "https://x.example.com", "status": "ONLINE"}

> {%
  client.test("POST platform without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}
