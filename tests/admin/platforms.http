import ./auth.http
run #auth

### List platforms — registry/platforms/*.json is the source of truth (ADR-014)
GET {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platforms listed from the registry fixtures", () => {
    client.assert(response.status === 200)
    client.assert(Array.isArray(response.body))
    const ids = response.body.map(p => p.id)
    client.assert(ids.includes("mock"))
    client.assert(ids.includes("mock-edelivery"))
    client.assert(response.body.every(p => p.status !== "DELETED"))
  })
%}

### Get the mock platform (registry/platforms/mock.json)
GET {{RUUTER_URL}}/admin/v1/platforms/mock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Mock platform read back from the registry", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "mock")
    client.assert(response.body.baseUrl === "http://ruuter:8086/mock-platform")
    client.assert(response.body.status === "ONLINE")
    client.assert(response.body.headers["X-Api-Key"] === "mock-secret-key")
  })
%}

### The platform credential is a hint, never the hash (ADR-004 / ADR-014)
GET {{RUUTER_URL}}/admin/v1/platforms/mock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("API key hint exposed, hash hidden", () => {
    client.assert(response.status === 200)
    client.assert(response.body.hasApiKey === true)
    client.assert(response.body.apiKeyHint === "ae2f98d4")
    client.assert(response.body.apiKeyHint.length === 8)
    client.assert(response.body.apiKeyHash === undefined)
    client.assert(response.body.apiKey === undefined)
  })
%}

### A platform without apiKeyHash has no inbound credential
GET {{RUUTER_URL}}/admin/v1/platforms/mock-edelivery
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Mock eDelivery platform read back from the registry", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "mock-edelivery")
    client.assert(response.body.baseUrl === "http://edelivery:8081/services/msh")
    client.assert(response.body.status === "ONLINE")
    client.assert(response.body.hasApiKey === false)
    client.assert(response.body.apiKeyHint === null || response.body.apiKeyHint === undefined)
  })
%}

### NEGATIVE: GET without auth → 401
GET {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json

> {%
  client.test("GET platforms without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}

### NEGATIVE: the platform write API is gone (ADR-014) — registry is read-only
# The path IS still routed, but only for GET, so a write method is "method not allowed"
# rather than "not found", and no guard runs to produce 401/403.
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json

{"id": "NOAUTH", "baseUrl": "https://x.example.com", "status": "ONLINE"}

> {%
  client.test("POST /admin/v1/platforms rejected — registry is read-only (405)", () => {
    client.assert(response.status === 405)
  })
%}

### NEGATIVE: keys are declared in the registry, so there is no rotate endpoint
POST {{RUUTER_URL}}/admin/v1/platforms/api-key/mock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("POST /admin/v1/platforms/api-key/mock rejected — read-only (405)", () => {
    client.assert(response.status === 405)
  })
%}

### NEGATIVE: status is registry-owned, so there is no ping endpoint
POST {{RUUTER_URL}}/admin/v1/platforms/ping/mock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("POST /admin/v1/platforms/ping/mock rejected — read-only (405)", () => {
    client.assert(response.status === 405)
  })
%}
