import ./auth.http
run #auth

### Create platform
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "demo",
  "baseUrl": "https://demo-platform.example.com/api",
  "headers": {"X-Api-Key": "test-key-123"},
  "eDeliveryCert": "-----BEGIN CERTIFICATE-----\ntest-cert\n-----END CERTIFICATE-----",
  "tlsCert": "-----BEGIN CERTIFICATE-----\ntest-tls-cert\n-----END CERTIFICATE-----",
  "status": "ONLINE"
}

> {%
  client.test("Platform created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.id === "demo")
    client.assert(response.body.baseUrl === "https://demo-platform.example.com/api")
    client.assert(response.body.status === "ONLINE")
  })
%}

### List platforms
GET {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platforms listed", () => {
    client.assert(response.status === 200)
    client.assert(response.body.length >= 1)
  })
%}

### Get single platform
GET {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Single platform found", () => {
    client.assert(response.status === 200)
    client.assert(response.body.id === "demo")
  })
%}

### Update platform
PUT {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "baseUrl": "https://demo-platform.example.com/api/v2",
  "headers": {"X-Api-Key": "updated-key-456"},
  "eDeliveryCert": "-----BEGIN CERTIFICATE-----\ntest-cert\n-----END CERTIFICATE-----",
  "tlsCert": "-----BEGIN CERTIFICATE-----\ntest-tls-cert\n-----END CERTIFICATE-----",
  "status": "ONLINE"
}

> {%
  client.test("Platform updated", () => {
    client.assert(response.status === 200)
    client.assert(response.body.baseUrl === "https://demo-platform.example.com/api/v2")
  })
%}

### Generate API key for platform (ADR-004)
# The gate stores only digest(key,'sha256') in platforms.api_key_hash, never the
# key itself — the plaintext is returned once here and never again. The
# consignments.guard hashes the incoming X-Api-Key and matches it against that
# hash (it used to compare plaintext against platforms.headers->>'X-Api-Key').
POST {{RUUTER_URL}}/admin/v1/platforms/api-key/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("API key generated", () => {
    client.assert(response.status === 201)
    client.assert(response.body.id === "demo")
    client.assert(/^[0-9a-f]{48}$/.test(response.body.apiKey))
    client.assert(response.body.apiKeyHint.length === 8)
    client.global.set("demoApiKey", response.body.apiKey)
  })
%}

### Regenerating replaces the key
POST {{RUUTER_URL}}/admin/v1/platforms/api-key/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("API key regenerated", () => {
    client.assert(response.status === 201)
    client.assert(response.body.apiKey !== client.global.get("demoApiKey"))
  })
%}

### Platform now shows a key hint, never the hash
GET {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("API key hint exposed, hash hidden", () => {
    client.assert(response.status === 200)
    client.assert(response.body.hasApiKey === true)
    client.assert(response.body.apiKeyHint.length === 8)
    client.assert(response.body.apiKeyHash === undefined)
    client.assert(response.body.apiKey === undefined)
  })
%}

### Generate API key for unknown platform → 404
POST {{RUUTER_URL}}/admin/v1/platforms/api-key/does-not-exist
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("API key generate 404 for unknown platform", () => {
    client.assert(response.status === 404)
  })
%}

### Delete platform
DELETE {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platform deleted", () => {
    client.assert(response.status === 204)
  })
%}

### Verify platform deleted
GET {{RUUTER_URL}}/admin/v1/platforms/demo
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platform deleted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.status === "DELETED")
  })
%}

### Ping platform (REST — mock-platform health endpoint)
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "ping-test",
  "baseUrl": "http://ruuter:8086/mock-platform/health",
  "status": "ONLINE"
}

> {%
  client.test("Platform created for ping", () => {
    client.assert(response.status === 201)
  })
%}

### Check ping result
POST {{RUUTER_URL}}/admin/v1/platforms/ping/ping-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Platform pinged (REST)", () => {
    client.assert(response.body.status === "ONLINE")
  })
%}

DELETE {{RUUTER_URL}}/admin/v1/platforms/ping-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### NEGATIVE: GET without auth → 401
GET {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json

> {%
  client.test("GET platforms without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}

### NEGATIVE: POST without auth → 401
POST {{RUUTER_URL}}/admin/v1/platforms
Content-Type: application/json

{"id": "NOAUTH", "baseUrl": "https://x.example.com", "status": "ONLINE"}

> {%
  client.test("POST platform without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}
