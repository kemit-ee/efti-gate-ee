import ./auth.http
run #auth

### Create user
POST {{RUUTER_URL}}/admin/v1/users
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "taraSub": "test-{{$timestamp}}",
  "name": "Test User"
}

> {%
  client.test("User created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.name === "Test User")
    client.assert(response.body.isUserActive === true)
    client.global.set("userId", response.body.id)
    client.global.set("userTaraSub", response.body.taraSub)
  })
%}

### Verify audit log recorded the user creation (issue #59)
GET {{RUUTER_URL}}/admin/v1/audit?resource=user&resourceId={{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Audit log has a user.create row", () => {
    client.assert(response.status === 200)
    client.assert(response.body.some(e => e.action === "user.create" && e.resourceId === client.global.get("userId")))
  })
%}

### List users
GET {{RUUTER_URL}}/admin/v1/users
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Users listed", () => {
    client.assert(response.status === 200)
    client.assert(response.body.length >= 1)
  })
%}

### Get single user
GET {{RUUTER_URL}}/admin/v1/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Single user found", () => {
    client.assert(response.status === 200)
    client.assert(response.body.name === "Test User")
  })
%}

### Update user
PUT {{RUUTER_URL}}/admin/v1/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "taraSub": "{{userTaraSub}}",
  "name": "Updated Test User"
}

> {%
  client.test("User updated", () => {
    client.assert(response.status === 200)
    client.assert(response.body.name === "Updated Test User")
  })
%}

### Verify audit log recorded the user update (issue #59)
GET {{RUUTER_URL}}/admin/v1/audit?resource=user&resourceId={{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Audit log has a user.update row", () => {
    client.assert(response.status === 200)
    client.assert(response.body.some(e => e.action === "user.update" && e.resourceId === client.global.get("userId")))
  })
%}

### Revoke user token
POST {{RUUTER_URL}}/admin/v1/users/revoke-token/{{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Token revoked", () => {
    client.assert(response.status === 204)
  })
%}

### Delete user
DELETE {{RUUTER_URL}}/admin/v1/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("User deleted", () => {
    client.assert(response.status === 204)
  })
%}

### Verify user deleted
GET {{RUUTER_URL}}/admin/v1/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("User deleted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.isUserActive === false)
  })
%}

### Verify audit log recorded the user deletion (issue #59)
GET {{RUUTER_URL}}/admin/v1/audit?resource=user&resourceId={{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Audit log has a user.delete row", () => {
    client.assert(response.status === 200)
    client.assert(response.body.some(e => e.action === "user.delete" && e.resourceId === client.global.get("userId")))
  })
%}

### NEGATIVE: GET without auth → 401
GET {{RUUTER_URL}}/admin/v1/users
Content-Type: application/json

> {%
  client.test("GET users without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}

### NEGATIVE: POST without auth → 401
POST {{RUUTER_URL}}/admin/v1/users
Content-Type: application/json

{"taraSub": "noauth", "name": "No Auth"}

> {%
  client.test("POST user without auth rejected", () => {
    client.assert(response.status === 401 || response.status === 403)
  })
%}
