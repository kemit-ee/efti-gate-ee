### [Auth] Login as admin — self-contained, run order does not matter
POST {{RUUTER_URL}}/auth/dev-login
Content-Type: application/json

{ "personalCode": "60001019906", "firstName": "Super", "lastName": "Admin" }

> {%
  client.test("[Auth] admin JWT issued", () => {
    client.assert(response.status === 200)
    client.global.set("adminToken", response.body.token)
  })
%}

### List all audit entries
GET {{RUUTER_URL}}/efti/api/v1/audit
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Audit log returned", () => {
    client.assert(response.status === 200)
  })
%}

### Filter audit by resource type
GET {{RUUTER_URL}}/efti/api/v1/audit?resource=consignment
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Audit filtered by resource", () => {
    client.assert(response.status === 200)
  })
%}

### Filter audit with pagination
GET {{RUUTER_URL}}/efti/api/v1/audit?limit=10&offset=0
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Audit pagination works", () => {
    client.assert(response.status === 200)
  })
%}
