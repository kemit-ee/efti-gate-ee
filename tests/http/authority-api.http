### Platform uploads a consignment to be searched/retrieved by authority
# No auth — platform-to-gate endpoint.
POST {{RUUTER_URL}}/efti/api/v1/consignments
Content-Type: text/xml

< ../../code/xml-mapper/xsd/FTI004/sample.xml

### Authority searches for local consignments
POST {{RUUTER_URL}}/efti/api/v1/authority/search
Content-Type: application/json
Authorization: Bearer {{authorityToken}}
X-Request-ID: 073b32bc-a081-11f1-8d67-3c9c0f2eb459

{
  "mainTransportId": {"operator": "EQ", "id": "VESSEL-001"}
}

> {%
  client.test("Local consignment", () => {
    client.assert(response.status === 200)
    client.assert(response.body[0].mainTransportId === "VESSEL-001")
    client.assert(response.body[0].acceptanceCountry === "DE")
  })
%}

