### ReSQL rejects invalid parameters with its headers envelope
POST {{RESQL_URL}}/efti/get_user_by_id
Authorization: Bearer {{RESQL_INTERNAL_TOKEN}}
Content-Type: application/json

{"userId":"60001019906","unexpectedRuntimeUpgradeField":true}

> {%
  client.test("ReSQL error envelope", () => {
    client.assert(response.status === 400);
    client.assert(Array.isArray(response.body) && response.body.length === 0);
    client.assert(response.headers.valueOf("X-Resql-Error-Code") != null);
    client.assert(response.headers.valueOf("X-Resql-Error-Message") != null);
    // A missing saved query is also a 400; the test must hit an existing one to mean anything.
    client.assert(!response.headers.valueOf("X-Resql-Error-Message").includes("does not exist"));
  });
%}

### Internal Kotlin routes reject a wrong service token
POST {{EDELIVERY_URL}}/api/v1/send/nonexistent
X-Internal-Service-Token: definitely-not-the-token
Content-Type: text/xml

<hello/>

> {%
  client.test("eDelivery send requires the internal service token", () => {
    client.assert(response.status === 401);
  });
%}

### TIM introspection requires client authentication
POST {{TIM_URL}}/introspect
Content-Type: application/json

{"token":"invalid-test-token"}

> {%
  client.test("TIM introspection denies missing client credentials", () => {
    client.assert(response.status === 401);
  });
%}
