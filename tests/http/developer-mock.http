### transport-means — member 70000000 lacks EU02 -> 403 FORBIDDEN_SUBSET
POST {{DEVELOPER_URL}}/developer/v1/transport-means
X-Road-Client: EE/GOV/70000000/tram
X-Road-Id: 4894e35d-bf0f-44a6-867a-8e51f1daa7e0
Content-Type: application/json

{ "identifier": "MOCK-PLATE-1" }

> {%
  client.test("403 FORBIDDEN_SUBSET", () => {
    client.assert(response.status === 403)
    client.assert(response.body.code === "FORBIDDEN_SUBSET")
    client.assert(response.body.deniedSubsets[0] === "EU02")
  })
%}

### search — hit
POST {{DEVELOPER_URL}}/developer/v1/search
X-Road-Client: EE/GOV/70000097/tram
X-Road-Id: 4894e35d-bf0f-44a6-867a-8e51f1daa7e0
Content-Type: application/json

{ "mainTransportId": { "operator": "EQ", "id": "MOCK-PLATE-1" } }

> {%
  client.test("one result", () => {
    client.assert(response.status === 200)
    client.assert(response.body.length === 1)
    client.assert(response.headers.valueOf("x-poll-more") === "false")
  })
%}

