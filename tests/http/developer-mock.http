# Developer mock of the X-Road authority surface (/developer/**).
# Standalone ruuter-xroad-mock container — no DB, no core. See docs/specs/x_road_developer_mock.md.
#
# X-Road-Client member codes with special meaning:
#   00000000 -> 403 FORBIDDEN (guard)
#   70000000 -> resolves but entitled to no subsets (FORBIDDEN_SUBSET / empty)
#   anything else well-formed -> mock authority "auth-mock" with subsets EU01,EU02,EU03,EU05

### health (public, no headers)
GET {{DEVELOPER_URL}}/developer/health/ready

> {%
  client.test("health 200", () => { client.assert(response.status === 200) })
%}

### echo — happy path
POST {{DEVELOPER_URL}}/developer/v1/echo
X-Road-Client: EE/GOV/70000097/tram
X-Road-Id: 4894e35d-bf0f-44a6-867a-8e51f1daa7e0
X-Road-UserId: EE30101010007
Content-Type: application/json

{ "hello": "world" }

> {%
  client.test("echo 200 + shape", () => {
    client.assert(response.status === 200)
    client.assert(response.body.xRoadClient === "EE/GOV/70000097/tram")
    client.assert(response.body.authority.registryCode === "70000097")
    client.assert(response.body.authority.subsets.length === 4)
    client.assert(response.body.echo.hello === "world")
  })
%}

### echo — missing X-Road-Client -> 401
POST {{DEVELOPER_URL}}/developer/v1/echo
X-Road-Id: 4894e35d-bf0f-44a6-867a-8e51f1daa7e0
Content-Type: application/json

{}

> {%
  client.test("401 UNAUTHORIZED", () => {
    client.assert(response.status === 401)
    client.assert(response.body.code === "UNAUTHORIZED")
  })
%}

