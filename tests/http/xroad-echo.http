import ../admin/auth.http
run #auth

### Setup: ensure test authority exists
DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  // 204 (deleted) or 404 (didn't exist) — both are fine
  client.test("Cleanup ok", () => {
    client.assert(response.status === 204 || response.status === 404)
  })
%}

###

POST {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "auth-xroad-test",
  "name": "X-Road Test Authority",
  "registryCode": "70000099",
  "subsets": ["EU01"],
  "status": "ACTIVE"
}

> {%
  client.test("Test authority created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.registryCode === "70000099")
    client.global.set("xroadTestRegistryCode", response.body.registryCode)
  })
%}

### Echo: valid X-Road client (registry_code matches authority)
POST {{RUUTER_URL}}/xroad/v1/echo
X-Road-Client: EE/GOV/70000099/testSubsystem
X-Road-Id: 0a11ce5e-0001-4d1d-8f1a-0ec100000001
X-Road-UserId: EE30101010007
Content-Type: application/json

{"hello": "world"}

> {%
  client.test("Echo returns 200 for known authority", () => {
    client.assert(response.status === 200)
    client.assert(response.body.xRoadClient === "EE/GOV/70000099/testSubsystem")
    client.assert(response.body.xRoadId === "0a11ce5e-0001-4d1d-8f1a-0ec100000001")
    client.assert(response.body.xRoadUserId === "EE30101010007")
    client.assert(response.body.authority.id === "auth-xroad-test")
    client.assert(response.body.authority.registryCode === "70000099")
    client.assert(response.body.echo.hello === "world")
  })
%}

### Echo: missing X-Road-Client header → 401 (the header is the credential)
POST {{RUUTER_URL}}/xroad/v1/echo
X-Road-Id: 0a11ce5e-0002-4d1d-8f2a-0ec100000002
Content-Type: application/json

{"hello": "world"}

> {%
  client.test("Missing X-Road-Client returns 401", () => {
    client.assert(response.status === 401)
    client.assert(response.body.type === "https://api.efti.ee/errors/unauthorized")
    client.assert(response.body.code === "UNAUTHORIZED")
  })
%}

### Echo: malformed X-Road-Client (only 2 parts) → 401
POST {{RUUTER_URL}}/xroad/v1/echo
X-Road-Client: EE/GOV
X-Road-Id: 0a11ce5e-0003-4d1d-8f3a-0ec100000003
Content-Type: application/json

{"hello": "world"}

> {%
  client.test("Malformed X-Road-Client returns 401", () => {
    client.assert(response.status === 401)
    client.assert(response.body.code === "UNAUTHORIZED")
  })
%}

### Echo: missing X-Road-Id header → 400
POST {{RUUTER_URL}}/xroad/v1/echo
X-Road-Client: EE/GOV/70000099/testSubsystem
Content-Type: application/json

{"hello": "world"}

> {%
  client.test("Missing X-Road-Id returns 400", () => {
    client.assert(response.status === 400)
    client.assert(response.body.code === "MISSING_REQUIRED_HEADER")
  })
%}

### Echo: unknown registry_code (not in authorities) → 403
POST {{RUUTER_URL}}/xroad/v1/echo
X-Road-Client: EE/GOV/99999999/unknownSubsystem
X-Road-Id: 0a11ce5e-0004-4d1d-8f4a-0ec100000004
Content-Type: application/json

{"hello": "world"}

> {%
  client.test("Unknown registry_code returns 403", () => {
    client.assert(response.status === 403)
    client.assert(response.body.type === "https://api.efti.ee/errors/forbidden")
    client.assert(response.body.code === "FORBIDDEN")
  })
%}

### Echo: member-level X-Road-Client (3 parts, no subsystem) is valid
POST {{RUUTER_URL}}/xroad/v1/echo
X-Road-Client: EE/GOV/70000099
X-Road-Id: 0a11ce5e-0005-4d1d-8f5a-0ec100000005
Content-Type: application/json

{"hello": "world"}

> {%
  client.test("Member-level 3-part client is accepted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.authority.registryCode === "70000099")
  })
%}

### Teardown: remove test authority
DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-test
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Teardown ok", () => {
    client.assert(response.status === 204)
  })
%}
