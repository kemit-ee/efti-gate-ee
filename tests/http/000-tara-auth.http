### Dev login as Super Admin
POST {{RUUTER_URL}}/efti/api/v1/auth/dev-login
Content-Type: application/json

{
  "personalCode": "60001019906",
  "firstName": "Super",
  "lastName": "Admin"
}

> {%
  client.test("Super Admin JWT issued", () => {
    client.assert(response.status === 200)
    client.assert(response.body.token.startsWith("eyJ"))
    client.global.set("adminToken", response.body.token)
  })
%}

### Dev login as Mari Tamm
POST {{RUUTER_URL}}/efti/api/v1/auth/dev-login
Content-Type: application/json

{
  "personalCode": "60001017869",
  "firstName": "Mari",
  "lastName": "Tamm"
}

> {%
  client.test("Authority JWT issued", () => {
    client.assert(response.status === 200)
    client.assert(response.body.token.startsWith("eyJ"))
    client.global.set("authorityToken", response.body.token)
  })
%}

### Dev login as unprovisioned user (exists in TARA, not in gate DB)
POST {{RUUTER_URL}}/efti/api/v1/auth/dev-login
Content-Type: application/json

{
  "personalCode": "60001017727",
  "firstName": "Provisioneerimata",
  "lastName": "Kasutaja"
}

> {%
  client.test("Unprovisioned user JWT issued", () => {
    client.assert(response.status === 200)
    client.assert(response.body.token.startsWith("eyJ"))
    client.global.set("unprovisionedToken", response.body.token)
  })
%}

### Get current user Super admin
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("Super Admin user profile returned", () => {
    client.assert(response.status === 200)
    client.assert(response.body.taraSub === "60001019906")
  })
%}

### Get current user Mari
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json
Authorization: Bearer {{authorityToken}}

> {%
  client.test("Mari user profile returned", () => {
    client.assert(response.status === 200)
    client.assert(response.body.taraSub === "60001017869")
  })
%}

### NEGATIVE: unprovisioned user rejected
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json
Authorization: Bearer {{unprovisionedToken}}

> {%
  client.test("Unprovisioned user rejected", () => {
    client.assert(response.status === 401)
  })
%}

### NEGATIVE: no token
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json

> {%
  client.test("No token rejected", () => {
    client.assert(response.status === 401)
  })
%}

### NEGATIVE: garbage token
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json
Authorization: Bearer garbage

> {%
  client.test("Garbage token rejected", () => {
    client.assert(response.status === 401)
  })
%}
