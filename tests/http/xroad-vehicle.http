DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-veh-no-eu02
Authorization: Bearer {{adminToken}}

> {%
  client.test("Teardown non-EU02 authority", () => {
    client.assert(response.status === 204)
  })
%}
