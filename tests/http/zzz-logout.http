# Logout lifecycle. Runs last (zzz- prefix) and uses its own throwaway token so
# blacklisting it never affects {{adminToken}} used by the other test files.

### Mint a throwaway Super Admin token for the logout tests
POST {{RUUTER_URL}}/efti/api/v1/auth/dev-login
Content-Type: application/json

{
  "personalCode": "60001019906",
  "firstName": "Super",
  "lastName": "Admin"
}

> {%
  client.test("Logout-test JWT issued", () => {
    client.assert(response.status === 200)
    client.global.set("logoutToken", response.body.token)
  })
%}

### Token works before logout
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json
Authorization: Bearer {{logoutToken}}

> {%
  client.test("Token valid before logout", () => {
    client.assert(response.status === 200)
  })
%}

### Logout
POST {{RUUTER_URL}}/efti/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {{logoutToken}}

> {%
  client.test("Logout successful", () => {
    client.assert(response.status === 200 || response.status === 204)
  })
%}

### Verify token rejected after logout
GET {{RUUTER_URL}}/efti/api/v1/user
Content-Type: application/json
Authorization: Bearer {{logoutToken}}

> {%
  client.test("Token rejected after logout", () => {
    client.assert(response.status === 401)
  })
%}

### Logout idempotent (calling again is safe)
POST {{RUUTER_URL}}/efti/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {{logoutToken}}

> {%
  client.test("Logout idempotent", () => {
    client.assert(response.status === 200 || response.status === 204)
  })
%}
