import ../admin/auth.http
run #auth

### Setup: upload a consignment to search for
# X-Api-Key hashed and matched against platforms.api_key_hash by consignments.guard
# (ADR-004); mock hash seeded by 20260902-platform-api-key.sql.
POST {{RUUTER_URL}}/platforms/v1/consignments
Content-Type: text/xml
X-Api-Key: mock-secret-key

< ../../code/xml-mapper/xsd/FTI004/sample.xml

### Authority searches for local consignments
POST {{RUUTER_URL}}/efti/api/v1/authority/search
Content-Type: application/json
X-Request-ID: 073b32bc-a081-11f1-8d67-3c9c0f2eb459
Authorization: Bearer {{adminToken}} # TODO: this is not right for authority

{
  "mainTransportId": {"operator": "EQ", "id": "VESSEL-001"}
}

> {%
  client.test("Local consignment", () => {
    client.assert(response.status === 200)
    client.assert(response.body[0].mainTransportId === "VESSEL-001")
    client.assert(response.body[0].acceptanceCountry === "DE")
    client.assert(response.body[0].xml.startsWith("<ParameterIDSetCriteria"))
  })
%}

### Setup: upload a consignment to search for in EU-MOCK gate
POST {{RUUTER_URL}}/platforms/v1/consignments/b0284c81-a79d-11f1-931a-4ca954ebfb9f
X-Gate-Id: EU-MOCK
Content-Type: text/xml
X-Api-Key: mock-secret-key

<ParameterIDSetCriteria xmlns:udt="urn:eu:move:eFTI:data:standard:UnqualifiedDataType:34">
  <CarrierAcceptanceDateParameterScope>
    <SpecifiedDateTime>
      <udt:DateTimeString format="102">20260903</udt:DateTimeString>
    </SpecifiedDateTime>
  </CarrierAcceptanceDateParameterScope>
  <CarrierAcceptanceCountryParameterScope>
    <CountryID>DE</CountryID>
  </CarrierAcceptanceCountryParameterScope>
  <MainCarriageTransportMeansIDParameterScope>
    <ID>MOCK-123</ID>
  </MainCarriageTransportMeansIDParameterScope>
  <MainCarriageModeCodeParameterScope>
    <TransportModeParameterCode>3</TransportModeParameterCode>
  </MainCarriageModeCodeParameterScope>
</ParameterIDSetCriteria>

### Authority searches for remote consignments
# @timeout 70
POST {{RUUTER_URL}}/efti/api/v1/authority/search
Content-Type: application/json
X-Request-ID: 073b32bc-a081-11f1-8d67-3c9c0f2eb459
Authorization: Bearer {{adminToken}} # TODO: this is not right for authority

{
  "mainTransportId": {"operator": "EQ", "id": "MOCK-123"}
}

> {%
  client.test("Local consignment", () => {
    client.assert(response.status === 200)
    client.assert(response.body[0].mainTransportId === "MOCK-123")
    client.assert(response.body[0].gateId === "EU-MOCK")
    client.assert(response.body[0].xml.startsWith("<ParameterIDSetCriteria"))
  })
%}

### Authority retrieves a full dataset of a consignment (local platform)
GET {{RUUTER_URL}}/efti/api/v1/authority/dataset/EU-EE/mock/b24ebf37-a068-11f1-b8f0-3c9c0f2eb459
X-Request-ID: 327b4aea-a081-11f1-a87b-3c9c0f2eb459
Authorization: Bearer {{adminToken}}

> {%
  client.test("Local platform dataset", () => {
    client.assert(response.status === 200)
    client.assert(response.headers.valueOf('content-type') === 'text/xml')
    client.assert(xpath(response.body, '//GrossWeightMeasure')[0].textContent === "15000.00")
    client.assert(xpath(response.body, '//MainCarriageLogisticsTransportMovement/ID')[0].textContent === "VOY-2021-001")
  })
%}

### Authority retrieves a full dataset of a consignment (remote platform)
GET {{RUUTER_URL}}/efti/api/v1/authority/dataset/EU-MOCK/mock/b0284c81-a79d-11f1-931a-4ca954ebfb9f
X-Request-ID: 327b4aea-a081-11f1-a87b-3c9c0f2eb459
Authorization: Bearer {{adminToken}}
