### Entitlement: an authority without EU02 is denied, on every scope
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000092/tram
X-Road-Id: 0a11ce5e-000e-4d1d-8fea-0ec00000000e
Content-Type: application/json

{ "identifier": "VESSEL-001" }

> {%
  client.test("Authority without EU02 gets 403 FORBIDDEN_SUBSET", () => {
    client.assert(response.status === 403)
    client.assert(response.body.code === "FORBIDDEN_SUBSET")
    client.assert(response.body.deniedSubsets.indexOf("EU02") !== -1)
    client.assert(response.body.permittedSubsets.indexOf("EU01") !== -1)
    client.assert(response.body.authorityId === "auth-xroad-tm-no-eu02")
    client.assert(JSON.stringify(response.body).indexOf("VESSEL-001") === -1, "a denial must not leak data about the identifier")
  })
%}

### Entitlement is checked before the existence shortcut too
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000092/tram
X-Road-Id: 0a11ce5e-000f-4d1d-8ffa-0ec00000000f
Content-Type: application/json

{ "identifier": "VESSEL-001", "scope": "existence" }

> {%
  client.test("scope existence is also EU02-gated", () => {
    client.assert(response.status === 403, "the cheap path must not bypass entitlement")
    client.assert(response.body.code === "FORBIDDEN_SUBSET")
    client.assert(response.body.registered === undefined, "a denial must not answer the question")
  })
%}

