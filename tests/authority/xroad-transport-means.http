import ../admin/auth.http
run #auth

# POST /xroad/v1/transport-means — a transport-means identifier in, the identifier-level data the
# gate holds out (ADR-006). Mode-neutral: road plate, vessel IMO, aircraft registration, or a
# transport-equipment (container) id.
#
# Fixtures come from tests/authority/authority-api.http, which uploads
# code/xml-mapper/xsd/FTI004/sample.xml and sorts before tests/http/ in the tests/*/*.http glob:
#   main_transport_id      VESSEL-001
#   used_equipment_ids     TE-001, TE-002
#   carried_equipment_ids  TE-003, TE-004
#   transport_reg_country  DE
#
# Registry codes 70000093 / 70000092 are unused elsewhere (echo 70000099, subsets 70000095-97,
# forward 70000094, admin 70000001/00000000).
#
# Every X-Road-Id must be a real UUID — the guard rejects anything else with 400 INVALID_REQUEST_ID.

### Cleanup: EU02-entitled authority
DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-tm
Authorization: Bearer {{adminToken}}

> {%
  client.test("Cleanup EU02 authority ok", () => {
    client.assert(response.status === 204 || response.status === 404)
  })
%}

### Cleanup: authority without EU02
DELETE {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-tm-no-eu02
Authorization: Bearer {{adminToken}}

> {%
  client.test("Cleanup non-EU02 authority ok", () => {
    client.assert(response.status === 204 || response.status === 404)
  })
%}

### Setup: authority entitled to EU02 (means of transport)
POST {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "auth-xroad-tm",
  "name": "X-Road Transport Means Authority",
  "registryCode": "70000093",
  "subsets": ["EU01", "EU02"],
  "status": "ACTIVE"
}

> {%
  client.test("EU02 authority created", () => {
    client.assert(response.status === 201)
    client.assert(response.body.registryCode === "70000093")
  })
%}

### Setup: authority NOT entitled to EU02
POST {{RUUTER_URL}}/admin/v1/authorities
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "auth-xroad-tm-no-eu02",
  "name": "X-Road Transport Means Authority Without EU02",
  "registryCode": "70000092",
  "subsets": ["EU01"],
  "status": "ACTIVE"
}

> {%
  client.test("Non-EU02 authority created", () => {
    client.assert(response.status === 201)
  })
%}

### scope local (default): main transport means identifier
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000093/ants
X-Road-Id: 0a11ce5e-0001-4d1d-8f1a-0ec000000001
X-Road-UserId: EE30101010007
Content-Type: application/json

{ "identifier": "VESSEL-001" }

> {%
  client.test("Main transport means identifier returns its consignments", () => {
    client.assert(response.status === 200, "expected 200, got " + response.status +
      " body=" + JSON.stringify(response.body))
    client.assert(response.body.identifier === "VESSEL-001")
    client.assert(response.body.scope === "local", "scope must default to local")
    client.assert(response.body.found >= 1, "expected at least one match, found=" + response.body.found)
    client.assert(Array.isArray(response.body.consignments))
    client.assert(response.body.consignments.length === response.body.found, "found must equal the array length")
    const c = response.body.consignments[0]
    client.assert(c.mainTransportId === "VESSEL-001")
    client.assert(c.uil !== undefined && c.uil.datasetId !== undefined, "uil.datasetId must be present so the caller can fetch the dataset")
    client.assert(c.uil.gateId !== undefined && c.uil.platformId !== undefined)
  })
%}

### CONTAINER SEARCH: a used-equipment id must match, not just the towing unit
# The point of the rename. A border check on a container number must not answer "not registered"
# merely because the number sits on the equipment rather than the main transport means.
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000093/ants
X-Road-Id: 0a11ce5e-0002-4d1d-8f2a-0ec000000002
Content-Type: application/json

{ "identifier": "TE-001" }

> {%
  client.test("Used-equipment id finds the consignment", () => {
    client.assert(response.status === 200, "expected 200, got " + response.status +
      " body=" + JSON.stringify(response.body))
    client.assert(response.body.found >= 1, "TE-001 is in used_equipment_ids and must match; found=" + response.body.found)
    const c = response.body.consignments[0]
    client.assert(c.usedEquipmentIds.indexOf("TE-001") !== -1)
    client.assert(c.mainTransportId === "VESSEL-001", "the same consignment is returned, matched via its equipment")
  })
%}

