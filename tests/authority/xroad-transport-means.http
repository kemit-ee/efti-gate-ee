X-Road-Id: 0a11ce5e-0003-4d1d-8f3a-0ec000000003
Content-Type: application/json

{ "identifier": "TE-003" }

> {%
  client.test("Carried-equipment id finds the consignment", () => {
    client.assert(response.status === 200, "expected 200, got " + response.status +
      " body=" + JSON.stringify(response.body))
    client.assert(response.body.found >= 1, "TE-003 is in carried_equipment_ids and must match; found=" + response.body.found)
    client.assert(response.body.consignments[0].carriedEquipmentIds.indexOf("TE-003") !== -1)
  })
%}

### scope existence: the sub-second ANTS border path, boolean only
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000093/ants
X-Road-Id: 0a11ce5e-0004-4d1d-8f4a-0ec000000004
Content-Type: application/json

{ "identifier": "VESSEL-001", "scope": "existence" }

> {%
  client.test("scope existence returns registered true and no data", () => {
    client.assert(response.status === 200, "expected 200, got " + response.status +
      " body=" + JSON.stringify(response.body))
    client.assert(response.body.registered === true)
    client.assert(response.body.scope === "existence")
    client.assert(response.body.identifier === "VESSEL-001")
    client.assert(response.body.consignments === undefined, "existence must not return consignment data")
    client.assert(response.body.found === undefined, "existence returns a boolean, not a count")
  })
%}

