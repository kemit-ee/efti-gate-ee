### REGRESSION: the local response must carry no dataset content
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000093/ants
X-Road-Id: 0a11ce5e-0007-4d1d-8f7a-0ec000000007
Content-Type: application/json

{ "identifier": "VESSEL-001" }

> {%
  client.test("No dataset content is returned", () => {
    client.assert(response.status === 200)
    client.assert(response.body.consignments[0].xml === undefined, "xml must never be returned")
    client.assert(JSON.stringify(response.body).indexOf("<") === -1, "no XML markup anywhere in the response")
  })
%}

