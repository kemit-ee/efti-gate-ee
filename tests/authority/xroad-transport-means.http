### identifier numeric → 400, not a 502 from the data layer
POST {{RUUTER_URL}}/xroad/v1/transport-means
X-Road-Client: EE/GOV/70000093/ants
X-Road-Id: 0a11ce5e-0012-4d1d-8f2a-0ec000000012
Content-Type: application/json

{ "identifier": 12345 }

> {%
  client.test("Numeric identifier returns 400, not 502", () => {
    client.assert(response.status === 400, "expected 400, got " + response.status)
    client.assert(response.body.code === "BAD_REQUEST_GENERAL")
