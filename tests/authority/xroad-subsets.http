import ../admin/auth.http
run #auth

# GET /xroad/v1/subsets — X-Road subset-permission discovery (ADR-006).
#
# Every authority this file depends on is committed under registry/authorities/ and served as
# build-time JSON by the `registry` image (ADR-011 §3); the admin write API for authorities no longer
# exists. The file only READS those fixtures — asserting each one is present before exercising it —
# and nothing here creates or deletes registry rows.
#
# Registry codes used here are 70000091 (the ambiguity pair), 70000096 (no entitlement) and
# 70000097 (the happy path); echo uses 70000099. A code no authority in the registry declares
# resolves to nothing, which is the only "revoked" state left — there is no tombstone.

### Fixture: registry/authorities/auth-xroad-subsets.json (applied by registry-sync at startup)
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-subsets
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-subsets fixture is present", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000097")
  })
%}

### Fixture: registry/authorities/auth-xroad-empty.json (applied by registry-sync at startup)
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-empty
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-empty fixture is present", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000096")
  })
%}

### Happy path: subsystem-level client gets its own permitted subsets
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/70000097/tram
X-Road-Id: 0a11ce5e-0001-4d1d-8f1a-0ec200000001
X-Road-UserId: EE30101010007

> {%
  client.test("Returns the authority's permitted subsets", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000097")
    client.assert(response.body.authorityId === "auth-xroad-subsets")
    client.assert(response.body.subsets.length === 2)
    client.assert(response.body.subsets.indexOf("EU01") !== -1)
    client.assert(response.body.subsets.indexOf("EU05") !== -1)
  })
%}

### Member-level client (3 parts, no subsystem) is a valid X-Road client id
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/70000097
X-Road-Id: 0a11ce5e-0002-4d1d-8f2a-0ec200000002

> {%
  client.test("3-part member-level client is accepted", () => {
    client.assert(response.status === 200)
    client.assert(response.body.authorityId === "auth-xroad-subsets")
  })
%}

### An authority entitled to nothing gets an empty list, not an error
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/70000096/tram
X-Road-Id: 0a11ce5e-0003-4d1d-8f3a-0ec200000003

> {%
  client.test("Empty entitlement returns an empty array", () => {
    client.assert(response.status === 200)
    client.assert(response.body.authorityId === "auth-xroad-empty")
    client.assert(response.body.subsets.length === 0)
  })
%}

### The GET surface is guarded: no X-Road-Client → 401
# Regression guard for the GET/v1/.guard.yml file. Without it this route would return 200 to
# anyone, because Ruuter only enforces a guard it finds walking up from the route's directory.
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Id: 0a11ce5e-0004-4d1d-8f4a-0ec200000004

> {%
  client.test("Missing X-Road-Client returns 401", () => {
    client.assert(response.status === 401)
    client.assert(response.body.type === "https://api.efti.ee/errors/unauthorized")
    client.assert(response.body.code === "UNAUTHORIZED")
  })
%}

### Malformed X-Road-Client (2 parts) → 401
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV
X-Road-Id: 0a11ce5e-0005-4d1d-8f5a-0ec200000005

> {%
  client.test("Malformed X-Road-Client returns 401", () => {
    client.assert(response.status === 401)
    client.assert(response.body.code === "UNAUTHORIZED")
  })
%}

### Missing X-Road-Id → 400
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/70000097/tram

> {%
  client.test("Missing X-Road-Id returns 400", () => {
    client.assert(response.status === 400)
    client.assert(response.body.type === "https://api.efti.ee/errors/missing-required-header")
    client.assert(response.body.code === "MISSING_REQUIRED_HEADER")
  })
%}

### Unknown registry code → 403
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/99999999/tram
X-Road-Id: 0a11ce5e-0006-4d1d-8f6a-0ec200000006

> {%
  client.test("Unknown registry code returns 403", () => {
    client.assert(response.status === 403)
    client.assert(response.body.code === "FORBIDDEN")
  })
%}

### Regression: a registry code shared by two authorities must be denied, not guessed
# authorities.registry_code has no unique constraint, so a registry can carry two rows with the
# same code. Returning either one would hand one organisation the other's subset entitlement, so both
# the guard and the handler must reject a >1 row count. The ambiguity is a permanent registry fixture
# pair — auth-xroad-ambig-a (EU01, EU02) and auth-xroad-ambig-b (EU03), both on 70000091 — so this case
# is asserted on every run instead of being created and torn down, and no other fixture may reuse
# 70000091.
### Fixture: registry/authorities/auth-xroad-ambig-a.json (applied by registry-sync at startup)
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-ambig-a
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-ambig-a fixture is present", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000091")
  })
%}

### Fixture: registry/authorities/auth-xroad-ambig-b.json (applied by registry-sync at startup)
GET {{RUUTER_URL}}/admin/v1/authorities/auth-xroad-ambig-b
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("auth-xroad-ambig-b fixture is present", () => {
    client.assert(response.status === 200)
    client.assert(response.body.registryCode === "70000091")
  })
%}

###
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/70000091/tram
X-Road-Id: 0a11ce5e-000b-4d1d-8fba-0ec20000000b

> {%
  client.test("Ambiguous registry code is denied, not resolved arbitrarily", () => {
    client.assert(response.status === 403)
    client.assert(response.body.code === "FORBIDDEN")
    client.assert(response.body.detail.indexOf("more than one") !== -1)
  })
%}

### The ambiguity is confined to 70000091 — 70000097 stays unambiguous
GET {{RUUTER_URL}}/xroad/v1/subsets
X-Road-Client: EE/GOV/70000097/tram
X-Road-Id: 0a11ce5e-000c-4d1d-8fca-0ec20000000c

> {%
  client.test("The single-authority code keeps its entitlement", () => {
    client.assert(response.status === 200)
    client.assert(response.body.authorityId === "auth-xroad-subsets")
    client.assert(response.body.subsets.length === 2)
  })
%}
