      "name": "BULK \u2014 GET list \u2014 verify 5 bulk platforms present",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "",
              "pm.test('All 5 bulk platforms are in the list', function () {",
              "    const ts = pm.collectionVariables.get('bulk_ts');",
              "    const platforms = pm.response.json();",
              "    const bulk = platforms.filter(p => p.id && p.id.includes('-bulk-') && p.id.endsWith('-' + ts));",
