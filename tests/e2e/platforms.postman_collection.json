{
  "info": {
    "name": "efti-gate-ee Admin \u2014 Platforms CRUD",
    "description": "End-to-end CRUD cycle for the Admin Platforms API: create \u2192 list \u2192 get \u2192 update \u2192 delete \u2192 bulk lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8086",
      "description": "Ruuter base URL. Override with --env-var base_url=... when running Newman."
    },
    {
      "key": "platform_id",
      "value": "",
      "description": "Test platform logical ID \u2014 set by the pre-request script to a unique value each run."
    },
    {
      "key": "bulk_ts",
      "value": "",
      "description": "Timestamp suffix used to make bulk platform IDs unique per test run."
    }
  ],
  "item": [
    {
      "name": "POST /api/v1/platforms \u2014 create platform",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var n = Math.floor(Math.random() * 9000) + 1000;",
              "pm.collectionVariables.set('platform_id', 'plt-test-' + n);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has a non-empty array under .response', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('response');",
              "    pm.expect(body.response).to.be.an('array').with.length.above(0);",
              "});",
              "",
              "pm.test('Created platform has correct id', function () {",
              "    const row = pm.response.json().response[0];",
              "    pm.expect(row.id).to.equal(pm.collectionVariables.get('platform_id'));",
              "});",
              "",
              "pm.test('Created platform has correct baseUrl', function () {",
              "    const row = pm.response.json().response[0];",
              "    const url = row.baseUrl || row.base_url;",
              "    pm.expect(url).to.equal('https://test-platform.example.com/efti/v1');",
              "});",
              "",
              "pm.test('Created platform has status ONLINE', function () {",
              "    const row = pm.response.json().response[0];",
              "    pm.expect(row.status).to.equal('ONLINE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{platform_id}}\",\n  \"baseUrl\": \"https://test-platform.example.com/efti/v1\",\n  \"status\": \"ONLINE\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/efti/api/v1/platforms",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "efti",
            "api",
            "v1",
            "platforms"
          ]
        }
      }
    },
    {
      "name": "GET /api/v1/platforms \u2014 list platforms (includes created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "});",
              "",
              "pm.test('Created platform is in the list', function () {",
              "    const platformId = pm.collectionVariables.get('platform_id');",
              "    const platforms = pm.response.json();",
              "    const found = platforms.some(p => p.id === platformId);",
              "    pm.expect(found, platformId + ' should be in platform list').to.be.true;",
              "});",
              "",
              "pm.test('All listed platforms have status field', function () {",
              "    const platforms = pm.response.json();",
              "    platforms.forEach(p => pm.expect(p.status).to.be.a('string'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/efti/api/v1/platforms?limit=200",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "efti",
            "api",
            "v1",
            "platforms"
          ],
          "query": [
            {
              "key": "limit",
              "value": "200"
            }
          ]
        }
      }
    },
