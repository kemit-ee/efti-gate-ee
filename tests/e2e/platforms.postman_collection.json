              "});",
              "",
              "pm.test('Platform id matches', function () {",
              "    const row = pm.response.json()[0];",
              "    pm.expect(row.id).to.equal(pm.collectionVariables.get('platform_id'));",
              "});",
              "",
              "pm.test('Platform has status field', function () {",
              "    const row = pm.response.json()[0];",
              "    pm.expect(row.status).to.be.a('string');",
              "});"
