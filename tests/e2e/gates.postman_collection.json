          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "",
              "pm.test('Exactly 2 bulk gates remain in list after deleting 3', function () {",
              "    const ts = pm.collectionVariables.get('bulk_ts');",
              "    const gates = pm.response.json();",
              "    const bulk = gates.filter(g => g.id && g.id.endsWith(ts));",
              "    pm.expect(bulk.length, 'Only 2 of 5 bulk gates should remain (3 deleted)').to.equal(2);",
              "});"
            ]
