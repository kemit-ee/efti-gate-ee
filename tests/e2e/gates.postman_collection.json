{
  "info": {
    "name": "efti-gate-ee Admin \u2014 Gates CRUD",
    "description": "End-to-end CRUD cycle for the Admin Gates API: create \u2192 list \u2192 get \u2192 update \u2192 delete \u2192 bulk lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8086",
      "description": "Ruuter base URL. Override with --env-var base_url=... when running Newman."
    },
    {
      "key": "gate_id",
      "value": "",
      "description": "Test gate logical ID \u2014 set by the pre-request script to a unique value each run."
    },
    {
      "key": "bulk_ts",
      "value": "",
      "description": "Timestamp suffix used to make bulk gate IDs unique per test run."
    }
  ],
  "item": [
    {
      "name": "POST /api/v1/gates \u2014 create gate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a unique gate id matching ^eu-[a-z]{2}[0-9]{2}$ for each test run.",
              "var n = Math.floor(Math.random() * 90) + 10;",
              "var id = 'eu-zz' + n;",
              "pm.collectionVariables.set('gate_id', id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response is an object', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('object');",
              "});",
              "",
              "pm.test('Created gate has correct id', function () {",
              "    const row = pm.response.json();",
              "    pm.expect(row.id).to.equal(pm.collectionVariables.get('gate_id'));",
              "});",
              "",
              "pm.test('Created gate has correct countryCode', function () {",
              "    const row = pm.response.json();",
              "    pm.expect(row.countryCode || row.country_code).to.equal('EE');",
              "});",
              "",
              "pm.test('Created gate has status field', function () {",
              "    const row = pm.response.json();",
              "    pm.expect(row.status).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{gate_id}}\",\n  \"countryCode\": \"EE\",\n  \"eDeliveryUrl\": \"https://test-gate.efti.ee/services/msh\",\n  \"status\": \"OFFLINE\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/efti/api/v1/gates",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "efti",
            "api",
            "v1",
            "gates"
          ]
        }
      }
    },
    {
      "name": "GET /api/v1/gates \u2014 list gates (includes created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "});",
              "",
              "pm.test('Created gate is in the list', function () {",
              "    const gateId = pm.collectionVariables.get('gate_id');",
              "    const gates = pm.response.json();",
              "    const found = gates.some(g => g.id === gateId);",
              "    pm.expect(found, gateId + ' should be in gate list').to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/efti/api/v1/gates?limit=200",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "efti",
            "api",
            "v1",
            "gates"
          ],
          "query": [
            {
              "key": "limit",
              "value": "200"
            }
          ]
        }
      }
    },
